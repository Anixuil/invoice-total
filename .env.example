# Copy to .env. The Jira creator module loads it automatically at startup.
# No built-in credentials are supplied.
JIRA_CREATOR_ENABLED=true
# Generate once using cryptography.fernet.Fernet.generate_key(); retain separately
# from the database. Changing this key without migrating ciphertext disables access.
JIRA_CREATOR_MASTER_KEY=3BcPDQsVQ2OnNuFqhOn-bAMKUYfOy2ceUa99fse3Q2Y=
# Used only when the database contains no users; no password length policy.
JIRA_CREATOR_ADMIN_USERNAME=liuxin01
JIRA_CREATOR_ADMIN_PASSWORD=Lx20010207@
# Exact origins, comma-separated. Include scheme and non-default port.
# Example: http://jira.example.internal,https://api.example.com
JIRA_CREATOR_ALLOWED_ORIGINS=http://jira.kingsware.cn,https://api.deepseek.com
# External origin when behind a reverse proxy, e.g. https://tools.example.internal
JIRA_CREATOR_PUBLIC_ORIGIN=http://jira.kingsware.cn,https://api.deepseek.com
# Set true when the browser accesses the site over HTTPS.
JIRA_CREATOR_COOKIE_SECURE=false
